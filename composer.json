{
    "name": "phasync/swerve-psr15",
    "description": "Run any PSR-15 request handler on swerve: Slim, Mezzio or your own, booted once per worker.",
    "type": "library",
    "license": "MIT",
    "keywords": ["psr-15", "psr-7", "slim", "mezzio", "swerve", "phasync", "application server", "long-running"],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "phasync/net": "^2.0.0-alpha4",
        "phasync/phasync": "^2.0.0-beta7",
        "phasync/swerve": "^0.1.0-beta6",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0",
        "friendsofphp/php-cs-fixer": "^3.58",
        "slim/slim": "^4.14"
    },
    "autoload": {
        "psr-4": {
            "Swerve\\Psr15\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "extra": {
        "swerve": {
            "adapter": "psr15",
            "entry": "Swerve\\Psr15\\entry"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../swerve",
            "options": {
                "symlink": true,
                "versions": {
                    "phasync/swerve": "0.1.0-beta6"
                }
            }
        }
    ],
    "minimum-stability": "beta",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest --stop-on-defect",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix --verbose",
        "php-cs-fixer-dry-run": "vendor/bin/php-cs-fixer fix --verbose --diff --dry-run"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
